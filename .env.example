# --- LLM (at least one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Search (at least one; Tavily is primary, others are automatic fallbacks) ---
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# --- Optional model overrides ---
SCOUT_MODEL=claude-sonnet-5-5
SCOUT_FAST_MODEL=claude-haiku-4-5-20251001
SCOUT_OPENAI_MODEL=gpt-4o

# --- Safety rails (runaway-loop protection) ---
SCOUT_MAX_LLM_CALLS=40
SCOUT_MAX_SEARCH_CALLS=60
